<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    fx:controller="controller.LoginController"
    prefHeight="650.0"
    prefWidth="1050.0"
    style="-fx-background-color: #F8F4EF;"
    stylesheets="@Style.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1">

    <!-- LEFT BRANDING PANEL -->
    <left>
        <VBox
            alignment="CENTER_LEFT"
            prefWidth="444.0"
            spacing="25.0"
            style="-fx-background-color: #241B18;"
            styleClass="sidebar"
            BorderPane.alignment="CENTER_LEFT">

            <padding>
                <Insets
                    bottom="45.0"
                    left="45.0"
                    right="45.0"
                    top="45.0"/>
            </padding>

            <children>

                <Label
                    style="-fx-text-fill: #D89A62;
                           -fx-font-size: 25px;
                           -fx-font-weight: bold;"
                    styleClass="brand-title"
                    text="NOVA BANK"/>

                <Label
                    prefWidth="341.0"
                    wrapText="true"
                    style="-fx-text-fill: white;
                           -fx-font-size: 34px;
                           -fx-font-weight: bold;"
                    styleClass="welcome-heading"
                    text="Banking made simpler"/>

                <Label
                    wrapText="true"
                    style="-fx-text-fill: #D8C5B8;
                           -fx-font-size: 15px;"
                    styleClass="welcome-description"
                    text="Manage your accounts, track transactions and take control of your financial future"/>

            </children>
        </VBox>
    </left>

    <!-- LOGIN PANEL -->
    <center>
        <VBox
            fx:id="loginContainer"
            alignment="CENTER_LEFT"
            prefWidth="620.0"
            spacing="15.0"
            style="-fx-background-color: #F8F4EF;"
            styleClass="login-container"
            BorderPane.alignment="CENTER">

            <padding>
                <Insets
                    bottom="55.0"
                    left="55.0"
                    right="55.0"
                    top="55.0"/>
            </padding>

            <children>

                <Label
                    style="-fx-font-size: 30px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #33251F;"
                    styleClass="login-heading"
                    text="Welcome back"/>

                <Label
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #8A7770;"
                    styleClass="login-subtitle"
                    text="Sign in to access your banking dashboard"/>

                <Label
                    styleClass="field-label"
                    text="Username"/>

                <TextField
                    fx:id="usernameField"
                    prefWidth="350.0"
                    promptText="Enter your username"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8px;
                           -fx-border-color: #E7D9CE;
                           -fx-border-radius: 8px;
                           -fx-padding: 12px;"
                    styleClass="text-field"/>

                <Label
                    styleClass="field-label"
                    text="Password"/>

                <PasswordField
                    fx:id="passwordField"
                    prefWidth="350.0"
                    promptText="Enter your password"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8px;
                           -fx-border-color: #E7D9CE;
                           -fx-border-radius: 8px;
                           -fx-padding: 12px;"
                    styleClass="password-field"/>

                <Label
                    fx:id="messageLabel"
                    wrapText="true"
                    style="-fx-text-fill: #B86E45;
                           -fx-font-size: 13px;"
                    text=""/>

                <Button
                    fx:id="loginButton"
                    mnemonicParsing="false"
                    onAction="#handleLogin"
                    prefWidth="350.0"
                    style="-fx-background-color: #B86E45;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 9px;
                           -fx-cursor: hand;"
                    styleClass="primary-button"
                    text="Sign In"/>

                <Button
                    mnemonicParsing="false"
                    onAction="#handleExit"
                    prefWidth="350.0"
                    style="-fx-background-color: #F2E4D8;
                           -fx-text-fill: #75452E;
                           -fx-font-size: 14px;
                           -fx-background-radius: 9px;"
                    styleClass="secondary-button"
                    text="Exit Application"/>

            </children>
        </VBox>
    </center>

</BorderPane>
