<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="780.0" prefWidth="1290.0"
            style="-fx-background-color: #F8F4EF;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="245.0" spacing="20.0"
              style="-fx-background-color: #241B18;">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <children>
                <Label text="NOVA"
                       style="-fx-font-size: 29px; -fx-font-weight: bold; -fx-text-fill: #F8F4EF;"/>

                <Label text="BANK"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #D89A62;"/>

                <Button text="Dashboard"
                        onAction="#handleDashboard"
                        maxWidth="Infinity"
                        style="-fx-background-color: #B86E45; -fx-text-fill: white; -fx-font-size: 15px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <Button text="My Accounts"
                        onAction="#handleMyAccounts"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #F8F4EF; -fx-font-size: 15px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <Button text="Open Account"
                        onAction="#handleOpenAccount"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #F8F4EF; -fx-font-size: 15px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <Button text="Transactions"
                        onAction="#handleTransactions"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #F8F4EF; -fx-font-size: 15px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <Button text="My Profile"
                        onAction="#handleProfile"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #F8F4EF; -fx-font-size: 15px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <VBox VBox.vgrow="ALWAYS"/>

                <Button text="Log Out"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #D89A62; -fx-font-size: 15px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- MAIN DASHBOARD -->
    <center>
        <VBox spacing="20.0"
              style="-fx-background-color: #F8F4EF;">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <children>

                <Label text="Welcome to NOVA BANK"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>

                <Label text="Manage your accounts, deposits and transactions in one place"
                       style="-fx-font-size: 14px; -fx-text-fill: #81736B;"/>

                <!-- SUMMARY CARDS -->
                <HBox spacing="20.0">
                    <children>

                        <VBox prefWidth="300.0" spacing="8.0"
                              style="-fx-background-color: white; -fx-background-radius: 12;">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <children>
                                <Label text="TOTAL BALANCE"
                                       style="-fx-font-size: 13px; -fx-text-fill: #81736B;"/>
                                <Label fx:id="totalBalanceLabel"
                                       text="BWP 0.00"
                                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>
                            </children>
                        </VBox>

                        <VBox prefWidth="300.0" spacing="8.0"
                              style="-fx-background-color: white; -fx-background-radius: 12;">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <children>
                                <Label text="ACTIVE ACCOUNTS"
                                       style="-fx-font-size: 13px; -fx-text-fill: #81736B;"/>
                                <Label fx:id="activeAccountsLabel"
                                       text="0"
                                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- ACCOUNT OVERVIEW -->
                <Label text="My Account Overview"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>

                <HBox spacing="18.0">
                    <children>

                        <VBox prefWidth="300.0" prefHeight="145.0"
                              spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 12;">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <children>
                                <Label text="SAVINGS ACCOUNT"
                                       style="-fx-font-size: 13px; -fx-text-fill: #B86E45; -fx-font-weight: bold;"/>
                                <Label fx:id="savingsBalanceLabel"
                                       text="BWP 0.00"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>
                                <Label fx:id="savingsNumberLabel"
                                       text="No account yet"
                                       style="-fx-font-size: 12px; -fx-text-fill: #81736B;"/>
                            </children>
                        </VBox>

                        <VBox prefWidth="300.0" prefHeight="145.0"
                              spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 12;">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <children>
                                <Label text="INVESTMENT ACCOUNT"
                                       style="-fx-font-size: 13px; -fx-text-fill: #B86E45; -fx-font-weight: bold;"/>
                                <Label fx:id="investmentBalanceLabel"
                                       text="BWP 0.00"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>
                                <Label fx:id="investmentNumberLabel"
                                       text="No account yet"
                                       style="-fx-font-size: 12px; -fx-text-fill: #81736B;"/>
                            </children>
                        </VBox>

                        <VBox prefWidth="300.0" prefHeight="145.0"
                              spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 12;">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <children>
                                <Label text="CHEQUE ACCOUNT"
                                       style="-fx-font-size: 13px; -fx-text-fill: #B86E45; -fx-font-weight: bold;"/>
                                <Label fx:id="chequeBalanceLabel"
                                       text="BWP 0.00"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>
                                <Label fx:id="chequeNumberLabel"
                                       text="No account yet"
                                       style="-fx-font-size: 12px; -fx-text-fill: #81736B;"/>
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- QUICK ACTIONS -->
                <Label text="Quick Actions"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>

                <HBox spacing="15.0">
                    <children>

                        <Button text="Open New Account"
                                onAction="#handleOpenAccount"
                                style="-fx-background-color: #241B18; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;">
                            <padding>
                                <Insets top="12" right="20" bottom="12" left="20"/>
                            </padding>
                        </Button>

                        <Button text="Deposit Funds"
                                onAction="#handleDeposit"
                                style="-fx-background-color: #241B18; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;">
                            <padding>
                                <Insets top="12" right="20" bottom="12" left="20"/>
                            </padding>
                        </Button>

                        <Button text="Withdraw Funds"
                                onAction="#handleWithdraw"
                                style="-fx-background-color: #241B18; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;">
                            <padding>
                                <Insets top="12" right="20" bottom="12" left="20"/>
                            </padding>
                        </Button>

                    </children>
                </HBox>

                <!-- RECENT TRANSACTIONS -->
                <Label text="Recent Transactions"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #241B18;"/>

                <TableView fx:id="recentTransactionsTable"
                           prefHeight="200.0"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="recentTransactionIdColumn"
                                     text="Transaction ID"
                                     prefWidth="150.0"/>
                        <TableColumn fx:id="recentTransactionTypeColumn"
                                     text="Transaction Type"
                                     prefWidth="200.0"/>
                        <TableColumn fx:id="recentAmountColumn"
                                     text="Amount (BWP)"
                                     prefWidth="180.0"/>
                        <TableColumn fx:id="recentDateColumn"
                                     text="Date"
                                     prefWidth="180.0"/>
                    </columns>
                </TableView>

            </children>
        </VBox>
    </center>

</BorderPane>
